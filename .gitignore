# Whitelist: only code, configs and result summaries are tracked (the manuscript stays local).
# Data, model caches, environments, the TeX binary and internal planning notes stay local.
/*
!/.gitignore
!/README.md
!/LICENSE

# paper/ and theory/ (manuscript, figures, proof notes) stay local: the repository holds code only.

!/virtual_cell/
/virtual_cell/*
!/virtual_cell/pyproject.toml
!/virtual_cell/uv.lock
!/virtual_cell/src/
/virtual_cell/src/__pycache__/
!/virtual_cell/pod/
!/virtual_cell/gears/
/virtual_cell/gears/*
!/virtual_cell/gears/gears_ctx.py
!/virtual_cell/gears/pyproject.toml
!/virtual_cell/gears/uv.lock
!/virtual_cell/results/
/virtual_cell/results/*
!/virtual_cell/results/*.md
!/virtual_cell/results/*.json
!/virtual_cell/results/*.log
!/virtual_cell/results/gears12/
!/virtual_cell/results/tahoe/
!/virtual_cell/results/state/
!/virtual_cell/results/pod_x/
!/virtual_cell/results/xdesign_pairs/
!/virtual_cell/results/fig_budget_summary.txt
!/virtual_cell/figures/
!/virtual_cell/prereg/
